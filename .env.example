# Do not commit the real account credentials.
BUAA_USERNAME=
BUAA_PASSWORD=

# Reservation release time, China Standard Time (UTC+08:00).
# The program opens the login page two minutes before this time.
OPEN_AT=2026-09-10T20:00:00+08:00

# false: stop immediately before the external reservation is created.
# true: click Submit automatically. Only enable after a dry run has confirmed
# the selected venue, date and slot are correct.
AUTO_SUBMIT=true

# Playwright storage state (cookies) reused between runs. The first run may
# need one manual login; afterwards this file lets later runs skip the login
# and therefore its captcha. It is equivalent to your password: keep it out
# of git and never share it.
SESSION_STATE=state.json
